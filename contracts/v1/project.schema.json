{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Archyar Project Document v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "name",
    "coordinateSystem",
    "originFloorId",
    "floors",
    "objects",
    "revision"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "projectId": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "coordinateSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "units", "handedness", "upAxis", "groundPlane", "origin"],
      "properties": {
        "id": { "const": "archyar-project-v1" },
        "units": { "const": "m" },
        "handedness": { "const": "right" },
        "upAxis": { "const": "Y" },
        "groundPlane": { "const": "XZ" },
        "origin": {
          "type": "array",
          "prefixItems": [{ "const": 0 }, { "const": 0 }, { "const": 0 }],
          "minItems": 3,
          "maxItems": 3
        },
        "headingReference": { "const": "confirmed-floor-heading" }
      }
    },
    "originFloorId": { "type": "string", "format": "uuid" },
    "revision": { "type": "integer", "minimum": 0 },
    "floors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "elevation", "ceilingHeight", "visible"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "elevation": { "type": "number" },
          "ceilingHeight": { "type": "number", "exclusiveMinimum": 0, "maximum": 20 },
          "visible": { "type": "boolean" }
        }
      }
    },
    "objects": {
      "type": "array",
      "items": { "$ref": "object.schema.json" }
    },
    "metadata": { "type": "object" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "vector3": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    }
  }
}
